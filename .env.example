# Environment variables for Hardhat
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Sepolia Testnet (optional — only needed for Sepolia deployment) ───────────
# Get a free RPC URL from https://www.alchemy.com  or  https://infura.io
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY_HERE

# Your MetaMask wallet private key (export from MetaMask → Account Details)
# Use a DEDICATED dev wallet — never your main wallet!
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
